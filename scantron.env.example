# Copy to scantron.env (which git ignores) to share the grader on a network.
# Leave scantron.env out entirely to run it for this computer only.

# 0.0.0.0 answers on the network; 127.0.0.1 is this computer only.
SCANTRON_HOST=0.0.0.0
SCANTRON_PORT=8765

# One password everyone uses, 10+ characters. Required unless the host is 127.0.0.1.
SCANTRON_PASSWORD=

# Set to 1 when people reach the grader through https (a Cloudflare Tunnel, say),
# so the sign-in cookie is only ever sent encrypted.
SCANTRON_HTTPS=0
